## 5. Main CICS COBOL Program Source (MFRNMAPP)
IDENTIFICATION DIVISION.
       PROGRAM-ID. MFRNMAPP.
       AUTHOR. Marlainna.
       ENVIRONMENT DIVISION.
       DATA DIVISION.

       WORKING-STORAGE SECTION.
       COPY MFRNSET.
       COPY DFHAID.
       COPY DFHBMSCA.

       01  WS-SKILL-DETAIL-RECORD.
           05  WS-REC-YEAR          PIC X(04).
           05  WS-REC-CATEGORY      PIC X(01).
           05  WS-REC-ROLE-TITLE    PIC X(40).
           05  WS-REC-SKILLS        PIC X(40).
           05  WS-REC-HIGHLIGHTS.
               10  WS-REC-HL1       PIC X(40).
               10  WS-REC-HL2       PIC X(40).
               10  WS-REC-HL3       PIC X(40).
           05  WS-REC-LINK-REF      PIC X(35).

       01  WS-FLAGS.
           05  VALID-DATA-SW        PIC X(01)  VALUE 'Y'.
               88  VALID-DATA                  VALUE 'Y'.
               88  INVALID-DATA                VALUE 'N'.
           05  SEND-FLAG            PIC X(01)  VALUE 'E'.
               88  SEND-ERASE                  VALUE 'E'.
               88  SEND-DATAONLY               VALUE 'D'.
               88  SEND-ERROR                  VALUE 'R'.

       01  WS-CICS-WORK-AREAS.
           05  RESPCODE             PIC S9(08) COMP VALUE ZERO.
           05  TSTAMP               PIC S9(15) COMP-3 VALUE ZERO.
           05  OUTDATE              PIC X(10)  VALUE SPACES.
           05  OUTTIME              PIC X(08)  VALUE SPACES.
           05  WS-COMM-AREA.
               10  WS-COMM-LAST-YEAR PIC X(04) VALUE SPACES.
               10  WS-COMM-BROWSE-SW PIC X(01) VALUE 'N'.

       LINKAGE SECTION.
       01  DFHCOMMAREA              PIC X(05).

       PROCEDURE DIVISION.
       0000-MAIN-PROCESS.
           IF EIBCALEN > ZERO
               MOVE DFHCOMMAREA TO WS-COMM-AREA
           END-IF.

           PERFORM 050-ASKTIMEPARA.

           IF EIBCALEN = ZERO
              PERFORM 050-SEND-INITIAL-MAP
           ELSE
              EVALUATE EIBAID
                 WHEN DFHPF1
                    PERFORM 100-READPARA
                 WHEN DFHPF2
                    PERFORM 200-WRITEPARA
                 WHEN DFHPF3
                    PERFORM 300-EXITPARA
                 WHEN DFHPF4
                    PERFORM 400-UPDATEPARA
                 WHEN DFHPF5
                    PERFORM 500-DELETEPARA
                 WHEN DFHPF6
                    PERFORM 600-CLEARPARA
                 WHEN DFHPF7
                    PERFORM 700-READPREVPARA
                 WHEN DFHPF8
                    PERFORM 800-READNEXTPARA
                 WHEN DFHENTER
                    PERFORM 000-BROWSEPARA
                 WHEN DFHPF10
                    PERFORM 450-CONF-UPDATE
                 WHEN DFHCLEAR
                    PERFORM 050-SEND-INITIAL-MAP
                 WHEN OTHER
                    PERFORM 110-RECEIVE-PARA
                    MOVE 'Invalid Key Pressed' TO MFMSGO
                    SET SEND-DATAONLY TO TRUE
                    PERFORM 900-SEND-PARA
              END-EVALUATE
           END-IF.

           EXEC CICS RETURN
                TRANSID('MYTR')
                COMMAREA(WS-COMM-AREA)
                LENGTH(LENGTH OF WS-COMM-AREA)
           END-EXEC.

       050-SEND-INITIAL-MAP.
           MOVE LOW-VALUES TO MFRNMAPO.
           PERFORM 050-MOVEPARA.
           MOVE 'Enter Year and press F1 to Read or F2 to Add.'
             TO MFMSGO.
           MOVE -1 TO MFYEARL.
           SET SEND-ERASE TO TRUE.
           PERFORM 900-SEND-PARA.

       050-ASKTIMEPARA.
           EXEC CICS
                ASKTIME
                ABSTIME(TSTAMP)
           END-EXEC.
           EXEC CICS
                FORMATTIME
                ABSTIME(TSTAMP)
                YYYYMMDD(OUTDATE)
                DATESEP('/')
                TIME(OUTTIME)
                TIMESEP(':')
           END-EXEC.

       050-MOVEPARA.
           MOVE OUTDATE TO MFDATEO.
           MOVE OUTTIME TO MFTIMEO.

       600-CLEARPARA.
           MOVE 'N' TO WS-COMM-BROWSE-SW.
           PERFORM 050-SEND-INITIAL-MAP.

       300-EXITPARA.
           EXEC CICS SEND CONTROL ERASE END-EXEC.
           EXEC CICS RETURN END-EXEC.

       100-READPARA.
           MOVE SPACES TO MFMSGO.
           PERFORM 110-RECEIVE-PARA.
           PERFORM 120-VALIDATE-YEAR.

           IF INVALID-DATA
              SET SEND-ERROR TO TRUE
              MOVE -1 TO MFYEARL
              PERFORM 900-SEND-PARA
              GO TO 100-EXIT
           END-IF.

           MOVE MFYEARI TO WS-REC-YEAR.

           EXEC CICS
                READ FILE('SKILLS')
                INTO(WS-SKILL-DETAIL-RECORD)
                RIDFLD(WS-REC-YEAR)
                RESP(RESPCODE)
           END-EXEC.

           IF RESPCODE = DFHRESP(NORMAL)
              PERFORM 180-MOVE-REC-MAP-PARA
              MOVE 'Record Found.' TO MFMSGO
              SET SEND-DATAONLY TO TRUE
              MOVE -1 TO MFCATL
           ELSE IF RESPCODE = DFHRESP(NOTFND)               
                  IF WS-SKILL-DETAIL-RECORD = SPACES 
                      MOVE 'YOUR FILE IS EMPTY ENTER YOUR FIRST RECORD'
                      TO MFMSGO       
                      MOVE DFHBMUNP TO MFYEARA
                      MOVE DFHBMUNP TO MFCATA
                      MOVE DFHBMUNP TO MFTITLEA
                      MOVE DFHBMUNP TO MFSKILLA
                      MOVE DFHBMUNP TO MFHL1A
                      MOVE DFHBMUNP TO MFHL2A
                      MOVE DFHBMUNP TO MFHL3A
                      MOVE DFHBMUNP TO MFLINKA
                      MOVE -1 TO MFYEARL                       
                  ELSE                  
                     MOVE 'RECORD NOT FOUND'
                     TO MFMSGO
                     SET SEND-ERROR TO TRUE 
                  END-IF 
           END-IF.
           PERFORM 900-SEND-PARA.
       100-EXIT. EXIT.

       200-WRITEPARA.
           MOVE SPACES TO MFMSGO.
           PERFORM 110-RECEIVE-PARA.
           PERFORM 120-VALIDATE-YEAR.
           PERFORM 150-VALIDATE-INPUT.

           IF INVALID-DATA
              SET SEND-ERROR TO TRUE
              MOVE -1 TO MFYEARL
              PERFORM 900-SEND-PARA
              GO TO 200-EXIT
           END-IF.

           INITIALIZE WS-SKILL-DETAIL-RECORD.
           PERFORM 170-MOVE-MAP-REC-PARA.
           
           EXEC CICS WRITE
                FILE('SKILLS')
                FROM(WS-SKILL-DETAIL-RECORD)
                RIDFLD(WS-REC-YEAR)
                RESP(RESPCODE)
           END-EXEC.

           IF RESPCODE = DFHRESP(NORMAL)
              MOVE 'Record Written Successfully.' TO MFMSGO              
           ELSE 
              IF RESPCODE = DFHRESP(DUPREC)
                 EXEC CICS READ
                     FILE('SKILLS')
                     INTO(WS-SKILL-DETAIL-RECORD)
                     RIDFLD(WS-REC-YEAR)
                     UPDATE
                     RESP(RESPCODE)
                  END-EXEC  
                 PERFORM 170-MOVE-MAP-REC-PARA
                 IF RESPCODE = DFHRESP(NORMAL)                   
                    EXEC CICS REWRITE
                    FILE('SKILLS')
                    FROM(WS-SKILL-DETAIL-RECORD)
                    RESP(RESPCODE)
                    END-EXEC
                    IF RESPCODE = DFHRESP(NORMAL)
                       MOVE 'Existing Record Updated.' TO MFMSGO
                    ELSE 
                       MOVE 'Record Rewrite Unsuccessful.' TO MFMSGO
                    END-IF 
                ELSE                     
                    MOVE 'Record Read for Update Failed.' TO MFMSGO 
                END-IF    
              ELSE
                 MOVE 'Record Write Unsuccessful.' TO MFMSGO    
              END-IF
           END-IF.
           SET SEND-DATAONLY TO TRUE.
           MOVE -1 TO MFYEARL.
           PERFORM 900-SEND-PARA.
       200-EXIT. EXIT.

       400-UPDATEPARA.
           MOVE SPACES TO MFMSGO.
           PERFORM 110-RECEIVE-PARA.
           PERFORM 120-VALIDATE-YEAR.

           IF INVALID-DATA
              SET SEND-ERROR TO TRUE
              MOVE -1 TO MFYEARL
              PERFORM 900-SEND-PARA
              GO TO 400-EXIT
           END-IF.

           MOVE MFYEARI TO WS-REC-YEAR.

           EXEC CICS
                READ FILE('SKILLS')
                INTO(WS-SKILL-DETAIL-RECORD)
                RIDFLD(WS-REC-YEAR)
                RESP(RESPCODE)
           END-EXEC.

           IF RESPCODE = DFHRESP(NORMAL)
              PERFORM 180-MOVE-REC-MAP-PARA
              MOVE 'Record Ready for Update. Edit and press F10.'
                TO MFMSGO
              SET SEND-DATAONLY TO TRUE
              MOVE -1 TO MFCATL
           ELSE
              MOVE 'Record Not Found for Update.' TO MFMSGO
              SET SEND-ERROR TO TRUE
              MOVE -1 TO MFYEARL
           END-IF.
           PERFORM 900-SEND-PARA.
       400-EXIT. EXIT.

       450-CONF-UPDATE.
           PERFORM 110-RECEIVE-PARA.
           PERFORM 120-VALIDATE-YEAR.

           IF INVALID-DATA
              SET SEND-ERROR TO TRUE
              MOVE -1 TO MFYEARL
              PERFORM 900-SEND-PARA
              GO TO 450-EXIT
           END-IF.

           MOVE MFYEARI TO WS-REC-YEAR.

           EXEC CICS READ
                FILE('SKILLS')
                INTO(WS-SKILL-DETAIL-RECORD)
                RIDFLD(WS-REC-YEAR)
                UPDATE
                RESP(RESPCODE)
           END-EXEC.

           IF RESPCODE = DFHRESP(NORMAL)
              PERFORM 170-MOVE-MAP-REC-PARA
              EXEC CICS REWRITE
                   FILE('SKILLS')
                   FROM(WS-SKILL-DETAIL-RECORD)
                   RESP(RESPCODE)
              END-EXEC
              IF RESPCODE = DFHRESP(NORMAL)
                 MOVE 'Record Updated Successfully.' TO MFMSGO
              ELSE
                 MOVE 'Update Failed on REWRITE.' TO MFMSGO
              END-IF
           ELSE
              MOVE 'Record Lock Failed. Update Aborted.' TO MFMSGO
           END-IF.

           SET SEND-DATAONLY TO TRUE.
           MOVE -1 TO MFYEARL.
           PERFORM 900-SEND-PARA.
       450-EXIT. EXIT.

       500-DELETEPARA.
           MOVE SPACES TO MFMSGO.
           PERFORM 110-RECEIVE-PARA.
           PERFORM 120-VALIDATE-YEAR.

           IF INVALID-DATA
              SET SEND-ERROR TO TRUE
              MOVE -1 TO MFYEARL
              PERFORM 900-SEND-PARA
              GO TO 500-EXIT
           END-IF.

           MOVE MFYEARI TO WS-REC-YEAR.

           EXEC CICS DELETE
                FILE('SKILLS')
                RIDFLD(WS-REC-YEAR)
                RESP(RESPCODE)
           END-EXEC.

           IF RESPCODE = DFHRESP(NORMAL)
              MOVE 'Record Deleted Successfully.' TO MFMSGO
           ELSE IF RESPCODE = DFHRESP(NOTFND)
              MOVE 'Record Not Found for Delete.' TO MFMSGO
           ELSE
              MOVE 'Delete Failed.' TO MFMSGO
           END-IF.
           SET SEND-DATAONLY TO TRUE.
           MOVE -1 TO MFYEARL.
           PERFORM 900-SEND-PARA.
       500-EXIT. EXIT.

       000-BROWSEPARA.
           PERFORM 110-RECEIVE-PARA.
           PERFORM 120-VALIDATE-YEAR.

           IF INVALID-DATA
              MOVE SPACES TO WS-REC-YEAR
           ELSE
              MOVE MFYEARI TO WS-REC-YEAR
           END-IF.

           EXEC CICS STARTBR
                FILE('SKILLS')
                RIDFLD(WS-REC-YEAR)
                GTEQ
                RESP(RESPCODE)
           END-EXEC.

           IF RESPCODE = DFHRESP(NORMAL)
              EXEC CICS READNEXT
                   FILE('SKILLS')
                   INTO(WS-SKILL-DETAIL-RECORD)
                   RIDFLD(WS-REC-YEAR)
                   RESP(RESPCODE)
              END-EXEC
              IF RESPCODE = DFHRESP(NORMAL)
                 PERFORM 180-MOVE-REC-MAP-PARA
                 MOVE 'Browse Started. Press F8 (Next) or F7 (Prev).'
                   TO MFMSGO
                 MOVE 'Y' TO WS-COMM-BROWSE-SW
                 MOVE WS-REC-YEAR TO WS-COMM-LAST-YEAR
              ELSE
                 MOVE 'No Records Found to Browse.' TO MFMSGO
              END-IF
              EXEC CICS ENDBR FILE('SKILLS') END-EXEC
           ELSE
              MOVE 'Error Starting Browse Session.' TO MFMSGO
           END-IF.
           SET SEND-DATAONLY TO TRUE.
           PERFORM 900-SEND-PARA.

       700-READPREVPARA.
           PERFORM 110-RECEIVE-PARA.
           MOVE MFYEARI TO WS-REC-YEAR.

           EXEC CICS STARTBR
                FILE('SKILLS')
                RIDFLD(WS-REC-YEAR)
                GTEQ
                RESP(RESPCODE)
           END-EXEC.

           IF RESPCODE = DFHRESP(NORMAL)
              EXEC CICS READPREV
                   FILE('SKILLS')
                   INTO(WS-SKILL-DETAIL-RECORD)
                   RIDFLD(WS-REC-YEAR)
                   RESP(RESPCODE)
              END-EXEC
              IF RESPCODE = DFHRESP(NORMAL)
                 PERFORM 180-MOVE-REC-MAP-PARA
                 MOVE 'Previous Record Retrieved.' TO MFMSGO
              ELSE
                 MOVE 'Beginning of File Reached.' TO MFMSGO
              END-IF
              EXEC CICS ENDBR FILE('SKILLS') END-EXEC
           ELSE
              MOVE 'Error Navigating Backward.' TO MFMSGO
           END-IF.
           SET SEND-DATAONLY TO TRUE.
           PERFORM 900-SEND-PARA.

       800-READNEXTPARA.
           PERFORM 110-RECEIVE-PARA.
           MOVE MFYEARI TO WS-REC-YEAR.

           EXEC CICS STARTBR
                FILE('SKILLS')
                RIDFLD(WS-REC-YEAR)
                GTEQ
                RESP(RESPCODE)
           END-EXEC.

           IF RESPCODE = DFHRESP(NORMAL)
              EXEC CICS READNEXT
                   FILE('SKILLS')
                   INTO(WS-SKILL-DETAIL-RECORD)
                   RIDFLD(WS-REC-YEAR)
                   RESP(RESPCODE)
              END-EXEC
              EXEC CICS READNEXT
                   FILE('SKILLS')
                   INTO(WS-SKILL-DETAIL-RECORD)
                   RIDFLD(WS-REC-YEAR)
                   RESP(RESPCODE)
              END-EXEC
              IF RESPCODE = DFHRESP(NORMAL)
                 PERFORM 180-MOVE-REC-MAP-PARA
                 MOVE 'Next Record Retrieved.' TO MFMSGO
              ELSE
                 MOVE 'End of File Reached.' TO MFMSGO
              END-IF
              EXEC CICS ENDBR FILE('SKILLS') END-EXEC
           ELSE
              MOVE 'Error Navigating Forward.' TO MFMSGO
           END-IF.
           SET SEND-DATAONLY TO TRUE.
           PERFORM 900-SEND-PARA.

       110-RECEIVE-PARA.
           EXEC CICS RECEIVE
                MAP('MFRNMAP')
                MAPSET('MFRNSET')
                RESP(RESPCODE)
           END-EXEC.

       120-VALIDATE-YEAR.
           SET VALID-DATA TO TRUE.
           IF MFYEARI = SPACES OR LOW-VALUES
              MOVE 'Year is Required.' TO MFMSGO
              SET INVALID-DATA TO TRUE
           ELSE IF MFYEARI NOT NUMERIC
              MOVE 'Year Must Be Numeric.' TO MFMSGO
              SET INVALID-DATA TO TRUE
           END-IF.

       150-VALIDATE-INPUT.
           IF MFCATI NOT = 'S' AND MFCATI NOT = 'P'
              MOVE 'Category must be S (Skills) or P (Projects).'
                TO MFMSGO
              SET INVALID-DATA TO TRUE
           END-IF.

       170-MOVE-MAP-REC-PARA.
           MOVE MFYEARI  TO WS-REC-YEAR.
           MOVE MFCATI   TO WS-REC-CATEGORY.
           MOVE MFTITLEI TO WS-REC-ROLE-TITLE.
           MOVE MFSKILLI TO WS-REC-SKILLS.
           MOVE MFHL1I   TO WS-REC-HL1.
           MOVE MFHL2I   TO WS-REC-HL2.
           MOVE MFHL3I   TO WS-REC-HL3.
           MOVE MFLINKI  TO WS-REC-LINK-REF.

       180-MOVE-REC-MAP-PARA.
           MOVE WS-REC-YEAR       TO MFYEARO.
           MOVE WS-REC-CATEGORY   TO MFCATO.
           MOVE WS-REC-ROLE-TITLE TO MFTITLEO.
           MOVE WS-REC-SKILLS     TO MFSKILLO.
           MOVE WS-REC-HL1        TO MFHL1O.
           MOVE WS-REC-HL2        TO MFHL2O.
